# ==============================================================================
# clfbench - Environment Configuration Template
# Run 'make setup' to generate '.env' with your host UID and GID automatically.
# ==============================================================================

# Host user/group mapping (prevents root-owned files in ./outputs)
UID=1000
GID=1000

# Host directory bind mounts
DATA_DIR=./data
OUTPUT_DIR=./outputs

# Hardware & container resources
CUDA_VISIBLE_DEVICES=all
SHM_SIZE=8gb

# Image tagging & build versions
IMAGE_TAG=0.1.0
PYTHON_VERSION=3.10
CUDA_VERSION=12.1.1
TORCH_VERSION=2.3.1
TORCHVISION_VERSION=0.18.1
CUDA_WHEEL_TAG=cu121

# Optional tooling & tracking
TENSORBOARD_PORT=6006
WANDB_API_KEY=
